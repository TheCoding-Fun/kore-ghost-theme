{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

<main class="gh-main w-full">

    {{#tag}}
        {{> "components/feature-header" title=name description=description}}
    {{/tag}}

    <div class="gh-outer w-full -mt-40">
        {{> "components/post-list" feed="archive" postFeedStyle=@custom.post_feed_style showTitle=false}}
    </div>

</main>