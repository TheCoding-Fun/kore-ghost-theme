{{!< default}}
{{!-- The tag above means: insert everything in this file into the body of the default.hbs template --}}

{{#post}}

<main class="gh-main gh-post-summary">

    <article class="gh-article {{post_class}}">

        {{> "components/post-header"}}

        <section class="gh-content gh-canvas gh-canvas-sidebar is-body">
            {{content}}

            <!-- Table of contents generated by TOCBOT -->
            <aside class="gh-sidebar">
                <div class="gh-toc-container">
                    <p class="pb-2">{{t "On this page:"}}</p>
                    <div class="gh-toc"></div>
                </div>
            </aside>
        </section>

    </article>

    {{#if comments}}
        <section class="gh-comments gh-canvas">
            {{comments mode="auto"}}
        </section>
    {{/if}}

</main>

{{/post}}

{{#if @custom.show_related_articles}}
    {{#get "posts" include="authors" filter="id:-{{post.id}}" limit="4" as |next|}}
        {{#if next}}
            <section class="gh-container gh-outer">
                <div class="gh-container-inner gh-inner">
                    <h2 class="gh-container-title">{{t "Read More"}}</h2>
                    <div class="gh-feed w-full grid grid-cols-12 gap-x-7 gap-y-7">
                        {{#foreach next}}
                            {{> "post-card" extraCss="lg:col-span-4 md:col-span-6" lazyLoad=true}}
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/if}}
    {{/get}}
{{/if}}
