{{!--
    Parameters:
    * imageSizes (text)
    * sizeCss (text)
    * extraCss (text)
    * sideCardCss (text)
    * lazyLoad (true, false)
--}}

<article class="k--card {{#if sizeCss}}{{sizeCss}}{{else}}k--card-lg{{/if}} {{post_class}} {{#match @custom.post_image_style "Display image"}} {{sideCardCss}} {{/match}} k--card-border border-(--color-base-300) bg-(--color-card-bg) w-full {{extraCss}} col-span-12">
    {{#if feature_image}}
        {{#match @custom.post_image_style "Display image"}}
            <figure class="{{#if sideCardCss}}basis-full min-w-0 {{#match @custom.post_feed_style "1 column"}}md:basis-1/3 md:min-w-[33%] lg:basis-1/4 lg:min-w-[25%]{{else}}md:basis-2/5 md:min-w-[40%]{{/match}}{{/if}}">
                <a href="{{url}}" class="block relative">
                    <div class="absolute left-4 top-4 z-15 flex items-center gap-2">
                        {{#if featured}}
                            <button class="k--btn k--btn-circle k--btn-sm k--btn-soft k--btn-primary k--tooltip k--tooltip-right inline-flex" data-tip="{{t "Featured"}}">
                                {{> "icons/star" icon_class="fill-current size-5"}}
                            </button>
                        {{/if}}
                        {{#unless access}}
                            {{^has visibility="public"}}
                                <button class="k--btn k--btn-circle k--btn-sm k--btn-soft k--btn-error k--tooltip k--tooltip-right inline-flex" data-tip="{{t "Restricted"}}">
                                    {{> "icons/lock-closed" icon_class="fill-current size-5"}}
                                </button>
                            {{/has}}
                        {{/unless}}
                    </div>
                    <img
                        class="w-full h-full object-cover aspect-video"
                        srcset="{{img_url feature_image size="xs" format="webp"}} 160w,
                                {{img_url feature_image size="s" format="webp"}} 320w,
                                {{img_url feature_image size="m" format="webp"}} 600w,
                                {{img_url feature_image size="l" format="webp"}} 960w,
                                {{img_url feature_image size="xl" format="webp"}} 1200w,
                                {{img_url feature_image size="xxl" format="webp"}} 2000w"
                        sizes="{{#if imageSizes}}{{imageSizes}}{{else}}700px{{/if}}"
                        src="{{img_url feature_image size="m"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        {{#if lazyLoad}}loading="lazy"{{/if}}
                    >
                </a>
            </figure>
        {{/match}}
    {{/if}}

    <div class="k--card-body p-6 space-y-4">
        <div class="flex-wrap gap-2 k--post-card-tag hidden {{#if tags}} flex!{{/if}}{{#match @custom.post_image_style "Off"}}{{#if featured}} flex!{{/if}}{{#unless access}}{{^has visibility="public"}} flex!{{/has}}{{/unless}}{{/match}}">
            {{#match @custom.post_image_style "Off"}}
                {{#if featured}}
                    <span class="k--tooltip" data-tip="{{t "Featured"}}">
                        {{> "icons/star" icon_class="fill-primary size-5"}}
                    </span>
                {{/if}}
                {{#unless access}}
                    {{^has visibility="public"}}
                        <span class="k--tooltip" data-tip="{{t "Restricted"}}">
                            {{> "icons/lock-closed" icon_class="fill-error size-5"}}
                        </span>
                    {{/has}}
                {{/unless}}
            {{/match}}
            {{#if tags}}
                {{#foreach tags}}
                    <a href="/tag/{{slug}}/" class="k--badge k--badge-outline text-content k--badge-sm" style="{{#if accent_color}}border-color: {{accent_color}}; background-color: {{color_to_rgba accent_color 0.2}}; {{/if}}">
                        {{name}}
                    </a>
                {{/foreach}}
            {{/if}}
        </div>

        <h3 class="k--card-title leading-tight">
            <a href="{{url}}" class="line-clamp-3" title="{{title}}">{{title}}</a>
        </h3>

        {{#if custom_excerpt}}
            <p class="flex-none text-base-content/80 line-clamp-4">
                {{custom_excerpt}}
            </p>
        {{else}}
            {{#if excerpt}}
                <p class="flex-none text-base-content/80 line-clamp-4">
                    {{excerpt}}
                </p>
            {{/if}}
        {{/if}}

        {{#match @custom.post_metadata "!=" "Off"}}
            <footer class="flex flex-col gap-4 text-sm text-base-content/60 k--post-card-meta sm:flex-row sm:items-center sm:justify-between">
                <div class="flex flex-col gap-3">
                    {{#match @custom.post_metadata "Show all"}}
                        <div class="flex items-center gap-3">
                            {{> "components/avatar-group"}}
                            <div class="space-y-1">
                                <div class="font-semibold text-base-content">By {{#foreach authors}}{{#if @first}}{{name}}{{else}}, {{name}}{{/if}}{{/foreach}}</div>
                                <div class="flex flex-wrap items-center gap-2 text-sm text-base-content/60">
                                    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>
                                    {{#if reading_time}}<span>• {{reading_time}}</span>{{/if}}
                                </div>
                            </div>
                        </div>
                    {{/match}}

                    {{#match @custom.post_metadata "Show author"}}
                        <div class="flex items-center gap-3">
                            {{> "components/avatar-group"}}
                            <div>By {{#foreach authors}}{{#if @first}}{{name}}{{else}}, {{name}}{{/if}}{{/foreach}}</div>
                        </div>
                    {{/match}}

                    {{#match @custom.post_metadata "Show publish date"}}
                        <div><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time></div>
                    {{/match}}

                    {{#match @custom.post_metadata "Show publish date, reading time"}}
                        <div class="flex items-center gap-2"><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time>{{#if reading_time}}<span>• {{reading_time}}</span>{{/if}}</div>
                    {{/match}}

                    {{#match @custom.post_metadata "Show author, publish date"}}
                        <div class="flex items-center gap-3">
                            {{> "components/avatar-group"}}
                            <div class="space-y-1">
                                <div>By {{#foreach authors}}{{#if @first}}{{name}}{{else}}, {{name}}{{/if}}{{/foreach}}</div>
                                <div><time datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD MMM YYYY"}}</time></div>
                            </div>
                        </div>
                    {{/match}}

                    {{#match @custom.post_metadata "Show author, reading time"}}
                        <div class="flex items-center gap-3">
                            {{> "components/avatar-group"}}
                            <div class="space-y-1">
                                <div>By {{#foreach authors}}{{#if @first}}{{name}}{{else}}, {{name}}{{/if}}{{/foreach}}</div>
                                {{#if reading_time}}<div>{{reading_time}}</div>{{/if}}
                            </div>
                        </div>
                    {{/match}}
                </div>
            </footer>
        {{/match}}
    </div>
</article>
