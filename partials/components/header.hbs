<header id="gh-navigation" class="gh-navigation gh-outer {{#if @custom.sticky_navigation}}fixed z-20 w-full bg-(--header-bg)/60 backdrop-blur-lg {{else}}bg-(--header-bg) {{/if}} is-{{#match navigationLayout "Logo on the left"}}left-logo{{else}}middle-logo{{/match}} gh-outer">
    <div class="gh-navigation-inner gh-inner">
        <div class="gh-navigation-brand">
            <a class="gh-navigation-logo is-title" href="{{@site.url}}">
                {{#if @site.logo}}
                    <img src="{{@site.logo}}" class="{{#if @custom.dark_mode_logo}}gh-light-logo{{else}}gh-logo{{/if}}" alt="{{@site.title}}">
                    {{#if @custom.dark_mode_logo}}
                        <img src="{{@custom.dark_mode_logo}}" class="gh-dark-logo" alt="{{@site.title}}">
                    {{/if}}
                {{else}}
                    {{@site.title}}
                {{/if}}
            </a>
            {{> "components/theme-switcher" toggle_id="toggle-mobile" additional_class="mr-2"}}
            {{> "search-toggle"}}
            <button class="gh-burger gh-icon-button" aria-label="{{t "Menu"}}">
                {{> "icons/burger"}}
                {{> "icons/close"}}
            </button>
        </div>

        <nav class="gh-navigation-menu">
            {{navigation}}
        </nav>

        <div class="gh-navigation-actions {{#if @custom.sticky_navigation}}bg-transparent {{/if}}bg-(--header-bg)">

            {{> "components/theme-switcher" toggle_id="toggle-main"}}

            {{#unless @site.members_enabled}}
                {{> "search-toggle"}}
            {{else}}
                {{> "search-toggle"}}
                <div class="gh-navigation-members">
                    {{#unless @member}}
                        {{#unless @site.members_invite_only}}
                            <span class="gh-gradient-underline">
                                <a href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                            </span>
                            {{#unless hideSubscribeButton}}
                                <button class="k--btn k--btn-accent" href="#/portal/signup" data-portal="signup">{{t "Subscribe"}}</button>
                            {{/unless}}
                        {{else}}
                            <a class="gh-button k--btn k--btn-accent" href="#/portal/signin" data-portal="signin">{{t "Sign in"}}</a>
                        {{/unless}}
                    {{else}}
                        <a class="gh-button k--btn k--btn-accent" href="#/portal/account" data-portal="account">{{t "Account"}}</a>
                    {{/unless}}
                </div>
            {{/unless}}
        </div>
    </div>
</header>
