<header
    class="gh-hero k--hero min-h-125"
    style="{{#if feature_image}}background-image: url({{feature_image}});{{/if}}"
>
    {{#if feature_image}}
        <div class="k--hero-overlay"></div>
        <div class="w-full h-full gh-header-gradient"></div>
    {{/if}}
    <div class="k--hero-content self-start pt-20 text-center{{#if feature_image}} text-shadow-lg/20 text-neutral-content{{/if}}">
        <div class="max-w-180">
            <h1 class="text-5xl font-bold">{{title}}</h1>
            {{#if description}}
                <p class="py-6 pb-45">
                    {{description}}
                </p>
            {{/if}}
        </div>
    </div>
</header>