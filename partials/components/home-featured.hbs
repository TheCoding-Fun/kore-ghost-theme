{{#match showFeatured "!=" "Off"}}
    {{#match showFeatured "Grid"}}
        {{#get "posts" filter="featured:true" include="authors,tags" limit=limit as |featured|}}
            <section class="gh-featured gh-outer">
                <div class="gh-featured-inner gh-inner">
                    <h2 class="gh-featured-title">{{t "Featured"}}</h2>
                    <div class="gh-featured-feed w-full grid grid-cols-12 gap-x-7 gap-y-7">
                        {{#foreach featured}}
                            {{> "post-card" extraCss="lg:col-span-4 md:col-span-6" }}
                        {{/foreach}}
                    </div>
                </div>
            </section>
        {{/get}}
    {{/match}}
    {{#match showFeatured "Carousel"}}
        {{#get "posts" filter="featured:true" include="authors,tags" limit=limit as |featured|}}
            <section class="gh-featured gh-outer">
                <div class="gh-featured-inner gh-inner">
                    <h2 class="gh-featured-title">{{t "Featured"}}</h2>
                    <div class="flex items-center gap-2 md:gap-3">
                        <button type="button" class="hidden k--btn k--btn-circle k--btn-ghost h-[420px] w-10 bg-base-200 shrink-0 md:flex" data-carousel-prev aria-label="Previous slide">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
                            </svg>
                        </button>

                        <div class="k--carousel k--carousel-center space-x-4 w-full overflow-x-auto rounded-box" data-autoplay="true">
                            {{#foreach featured}}
                                <div class="k--carousel-item snap-start first:pl-0 last:pr-0">
                                    <div class="relative h-[420px] w-[min(86vw,760px)] overflow-hidden rounded-box shadow-lg">
                                        <div class="k--card k--image-full relative h-full w-full">
                                            <figure class="h-full w-full">
                                                {{#if feature_image}}
                                                    <img
                                                        src="{{img_url feature_image size="m"}}"
                                                        alt="{{title}}"
                                                        class="h-full w-full object-cover brightness-100"
                                                    />
                                                {{else}}
                                                    <div class="h-full w-full bg-[linear-gradient(135deg,_var(--color-primary)_0%,_var(--ghost-accent-color)_48%,_var(--color-secondary)_100%)]"></div>
                                                {{/if}}
                                            </figure>
                                            <div class="gh-black-overlay absolute inset-0 z-0 bg-linear-to-t {{#if feature_image}}from-black/80 via-black/40 to-transparent{{else}}from-black/80 via-black/50 to-black/10{{/if}}"></div>
                                            <div class="k--card-body relative z-10 justify-end p-5 md:p-6">
                                                <div class="mb-2 flex items-center gap-2">
                                                    {{#if tags}}
                                                        {{#foreach tags limit="2"}}
                                                            <a href="{{url}}" class="relative z-20 k--badge k--badge-soft k--badge-primary no-underline hover:opacity-90">{{name}}</a>
                                                        {{/foreach}}
                                                    {{/if}}
                                                </div>
                                                <a href="{{url}}" class="relative z-20 block text-current no-underline hover:text-current">
                                                    <h3 class="k--card-title text-xl font-semibold md:text-2xl mb-3">{{title}}</h3>
                                                    {{#if custom_excerpt}}
                                                        <p class="mt-2 flex-none line-clamp-4">
                                                            {{custom_excerpt}}
                                                        </p>
                                                    {{else}}
                                                        {{#if excerpt}}
                                                            <p class="mt-2 flex-none line-clamp-4">
                                                                {{excerpt}}
                                                            </p>
                                                        {{/if}}
                                                    {{/if}}
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {{/foreach}}
                        </div>

                        <button type="button" class="hidden k--btn k--btn-circle k--btn-ghost h-[420px] w-10 shrink-0 bg-base-200 md:flex" data-carousel-next aria-label="Next slide">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.8" stroke="currentColor" class="h-5 w-5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5 15.75 12l-7.5 7.5" />
                            </svg>
                        </button>
                    </div>
                </div>
            </section>
        {{/get}}


    {{/match}}
{{/match}}
