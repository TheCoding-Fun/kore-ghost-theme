{{#if recommendations}}
    {{#foreach recommendations as |rec|}}
        <a href="{{rec.url}}" data-recommendation="{{rec.id}}" class="k--link k--link-hover inline-flex items-baseline" target="_blank" rel="noopener">
            {{#if rec.favicon}}
                <img src="{{rec.favicon}}" alt="{{rec.title}}" class="self-center w-4 h-4 rounded-full mr-1" loading="lazy" onerror="this.style.display='none';">
            {{/if}}
            <span>{{rec.title}}</span>
        </a>
    {{/foreach}}
{{/if}}